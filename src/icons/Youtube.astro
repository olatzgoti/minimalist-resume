---
// YouTubeIcon.astro

const { size = 24, class: className = '' } = Astro.props;
---

<svg 
  width={size} 
  height={size} 
  viewBox="0 0 24 24" 
  fill="none" 
  xmlns="http://www.w3.org/2000/svg"
  class={className}
>
  <!-- Fondo rojo característico de YouTube -->
  <rect x="2" y="6" width="20" height="12" rx="3" ry="3" fill="#FF0000"/>
  
  <!-- Botón de play (triángulo blanco) -->
  <polygon points="10,9 10,15 16,12" fill="white"/>
</svg>